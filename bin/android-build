#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  cat <<'EOF'
Usage: bin/android-build [GRADLE_ARGS...]

Build the debug APK with assembleDebug. Remaining arguments are passed to Gradle.
EOF
  exit 0
fi

exec "$SCRIPT_DIR/android-gradle" assembleDebug "$@"
