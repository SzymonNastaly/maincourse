#!/usr/bin/env ruby
require_relative "../lib/api_error_contract"
require "json"
require "rexml/document"

ROOT = File.expand_path("..", __dir__)
GROUPS = { "errors" => "ApiErrorCode", "imports" => "ImportErrorCode", "fields" => "ValidationFieldCode", "rules" => "ValidationRuleCode" }.freeze
SWIFT = "hauptgang-ios/Hauptgang/Models/ApiErrorCodes.swift"
KOTLIN = "maincourse-android/app/src/main/java/com/getmaincourse/app/data/network/ApiErrorCodes.kt"

definitions = ApiErrorContract::DEFINITIONS
definitions.each do |group, entries|
  raise "Unexpected group #{group}" unless GROUPS.key?(group)
  entries.each do |code, entry|
    raise "Invalid identifier #{code}" unless code.match?(/\A[a-z][a-z0-9_]*\z/)
    raise "Missing meaning for #{code}" if entry.fetch("meaning").strip.empty?
    raise "Unknown parameter type for #{code}" unless entry.fetch("params").values.all? { |type| type == "integer" }
    raise "Add typed parameter support to both clients for #{code}" unless (entry.fetch("params").keys - ["count"]).empty?
  end
end

swift = ""
kotlin = "// Generated by bin/api-error-contract --generate. Do not edit.\npackage com.getmaincourse.app.data.network\n\n"
GROUPS.each do |group, type|
  codes = definitions.fetch(group).keys.sort
  swift += "enum #{type}: String, CaseIterable {\n    // Generated by bin/api-error-contract --generate. Do not edit.\n" + codes.map { |code| "    case #{code}\n" }.join + "}\n\n"
  kotlin += "enum class #{type}(val wire: String) {\n" + codes.map { |code| "    #{code.upcase}(\"#{code}\")" }.join(",\n") + ";\n\n"
  kotlin += "    companion object {\n        fun fromWire(value: String?): #{type}? = entries.find { it.wire == value }\n    }\n}\n\n"
end
outputs = { SWIFT => swift.rstrip + "\n", KOTLIN => kotlin.rstrip + "\n" }
if ARGV == ["--generate"]
  outputs.each { |path, content| File.write(File.join(ROOT, path), content) }
  puts "Generated Swift and Kotlin wire enums. Implement every new case in both renderers."
elsif ARGV == ["--check"] || ARGV.empty?
  outputs.each do |path, content|
    abort "#{path} is stale. Run bin/api-error-contract --generate." unless File.read(File.join(ROOT, path)) == content
  end
  # These dedicated renderer files have exhaustive enum switches. Check coverage
  # even on CI hosts without native SDKs; native compilers enforce exhaustiveness too.
  GROUPS.each do |group, type|
    swift_path = File.join(ROOT, "hauptgang-ios/Hauptgang/Models/#{type}+Message.swift")
    kotlin_path = File.join(ROOT, "maincourse-android/app/src/main/java/com/getmaincourse/app/data/network/#{type}Message.kt")
    swift_source = File.read(swift_path).gsub(%r{/\*.*?\*/}m, "").gsub(%r{^\s*//.*$}, "")
    kotlin_source = File.read(kotlin_path).gsub(%r{/\*.*?\*/}m, "").gsub(%r{^\s*//.*$}, "")
    abort "Known-code renderer must not have a fallback: #{type}" if swift_source.match?(/\bdefault\s*:/) || kotlin_source.match?(/\belse\s*->/)
    swift_cases = swift_source.scan(/^\s*case\s+([^:]+):/).flat_map { |match| match.first.scan(/\.([a-z][a-z0-9_]*)/).flatten }.uniq.sort
    kotlin_cases = kotlin_source.scan(/^\s*#{type}\.([A-Z][A-Z0-9_]*)\s*->/).flatten.map(&:downcase).uniq.sort
    [swift_cases, kotlin_cases].each do |cases|
      abort "#{type} mappings differ from contract: #{(definitions.fetch(group).keys - cases).inspect} missing; #{(cases - definitions.fetch(group).keys).inspect} extra" unless cases == definitions.fetch(group).keys.sort
    end
    swift_source.split(/(?=^\s*case\s+\.)/).drop(1).each do |arm|
      abort "#{type} #{arm.lines.first.strip} needs an explicit localized message" unless arm.match?(/String\(\s*localized:/)
    end
    kotlin_source.split(/(?=^\s*#{type}\.)/).drop(1).each do |arm|
      abort "#{type} #{arm.lines.first.strip} needs an explicit resource message" unless arm.match?(/strings\.text\(R\.string\./)
    end
    # Dedicated renderers use explicit English keys (no interpolation in the key)
    # and Android R.string IDs; enforce resource existence in both iOS bundles.
    swift_keys = swift_source.scan(/String\(\s*localized:\s*"((?:\\.|[^"\\])*)"/).flatten.map { |key| JSON.parse('"' + key + '"') }
    abort "No localization keys found in #{swift_path}" if swift_keys.empty?
    %w[hauptgang-ios/Hauptgang/Resources/Localizable.xcstrings hauptgang-ios/ImportRecipeExtension/Localizable.xcstrings].each do |catalog|
      strings = JSON.parse(File.read(File.join(ROOT, catalog))).fetch("strings")
      missing = swift_keys.reject { |key| strings.key?(key) && strings[key].dig("localizations", "en") }
      abort "#{catalog} missing #{missing.inspect}" unless missing.empty?
    end
    android_keys = kotlin_source.scan(/R\.string\.([a-z0-9_]+)/).flatten
    resources = Dir[File.join(ROOT, "maincourse-android/app/src/main/res/values/*.xml")].flat_map do |file|
      REXML::XPath.match(REXML::Document.new(File.read(file)), "resources/string").map { |node| node.attributes["name"] }
    end
    abort "Android resources missing #{(android_keys - resources).inspect}" unless (android_keys - resources).empty?
  end
  puts "API error contract, generated enums, exhaustive mappings and resources agree."
else
  abort "Usage: bin/api-error-contract [--generate|--check]"
end
