<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac's build account signs with an App Store Connect key whose App Manager role gets no
     cloud-managed distribution certificate, so it names the certificate and profiles itself.
     bin/ios-release downloads the profiles before it exports. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>R69J54A3P5</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>app.hauptgang.ios</key>
		<string>Hauptgang App Store (devbox)</string>
		<key>app.hauptgang.ios.share-extension</key>
		<string>Hauptgang share extension App Store (devbox)</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
