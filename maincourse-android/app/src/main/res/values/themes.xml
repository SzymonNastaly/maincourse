<resources>
    <style name="Theme.MainCourse" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/mc_canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.MainCourse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mc_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MainCourse</item>
    </style>
</resources>
