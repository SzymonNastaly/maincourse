# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore macOS system files
.DS_Store

# Ignore tool state directories
.playwright-mcp/
.dex/

# Ignore Xcode build artifacts
/build/
hauptgang-ios/build/

agents/

# Recipe corpus HTML snapshots (large, regenerate with: bin/rails recipe_corpus:fetch)
test/recipe_corpus/snapshots/*
!test/recipe_corpus/snapshots/static/
test/recipe_corpus/snapshots/static/*
!test/recipe_corpus/snapshots/static/.keep

# Migration safety tarballs -- contain production data, never commit
*.tar.gz

# Codex CLI config (contains API keys)
/.codex/

# App Store Connect build artifacts (.ipa / .xcarchive)
hauptgang-ios/.asc/

# asc release checkpoints (repo root, written by `asc release stage`)
/.asc/
