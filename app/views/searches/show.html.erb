<% page_title t("web.search") %>

<div class="px-4 pt-[18px] md:px-[30px] md:pt-[26px]">
  <%= form_with url: search_path, method: :get do |form| %>
    <div class="flex items-center gap-2.5 rounded-card border-[1.5px] border-accent bg-surface px-3 py-3 ring-3 ring-accent-tint md:px-3.5">
      <%= icon "search", size: 17, stroke: 2.2, class: "text-accent" %>
      <%= form.search_field :q, value: @query,
                            autofocus: true,
                            placeholder: t("web.search_your_recipes"),
                            class: "w-full min-w-0 bg-transparent text-[14px] text-ink placeholder:font-light placeholder:text-muted focus:outline-none md:text-[15px]",
                            data: { search_shortcut_target: "input", testid: "search-input" },
                            "aria-label": t("web.search_your_recipes") %>
      <% if @query.present? %>
        <%= link_to search_path, class: "text-muted hover:text-ink", "aria-label": t("web.clear_search") do %>
          <%= icon "x", size: 15, stroke: 2.2 %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @query.present? %>
    <div class="pt-4 pb-3.5">
      <span class="text-[12.5px] font-light text-muted">
        <%= t("web.search_results_html", count: @results.size, number: mono(@results.size, class: "text-[12px] text-ink"), names: @cookbooks.map(&:name).to_sentence) %>
      </span>
    </div>
  <% end %>
</div>

<div class="px-4 pb-10 md:px-[30px]">
  <% if @query.blank? %>
    <%= render "shared/empty_state",
               icon: "search",
               title: t("web.search_your_recipes"),
               body: t("web.search_hint") %>
  <% elsif @results.any? %>
    <div class="grid grid-cols-2 gap-x-3.5 gap-y-[18px] md:grid-cols-3 md:gap-x-5 md:gap-y-6">
      <%= render partial: "recipes/card", collection: @results, as: :recipe %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
               icon: "search",
               title: t("web.no_results"),
               body: t("web.no_results_hint") %>
  <% end %>
</div>
