<% if content_for?(:mobile_header) %>
  <%= yield :mobile_header %>
<% else %>
  <header class="flex shrink-0 items-center gap-[11px] border-b border-line bg-surface px-3.5 py-[13px] md:hidden">
    <button type="button"
            class="-ml-1 flex size-[34px] items-center justify-center rounded-card text-ink hover:bg-sunken"
            data-action="drawer#open"
            aria-label="Open menu"
            data-testid="drawer-toggle">
      <%= icon "menu", size: 19, stroke: 2 %>
    </button>

    <%= link_to root_path, class: "flex grow items-center gap-2" do %>
      <%= brand_mark size: 20 %>
      <span class="text-[14px] font-semibold tracking-[-0.25px]">MainCourse</span>
    <% end %>

    <% if content_for?(:app_bar_right) %>
      <%= yield :app_bar_right %>
    <% elsif Current.user %>
      <%= link_to edit_settings_path,
                  class: "flex size-7 items-center justify-center rounded-control bg-line text-[10px] font-semibold text-body" do %>
        <%= user_initials(Current.user) %>
      <% end %>
    <% end %>
  </header>
<% end %>
