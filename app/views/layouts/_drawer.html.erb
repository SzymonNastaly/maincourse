<%# The rail slides in from the menu button on small screens. No bottom tab bar. %>
<div class="fixed inset-0 z-40 hidden md:hidden"
     data-drawer-target="overlay"
     data-testid="drawer">
  <div class="absolute inset-0 bg-ink/45 opacity-0 transition-opacity duration-200"
       data-drawer-target="backdrop"
       data-action="click->drawer#close"></div>

  <aside class="absolute inset-y-0 left-0 flex w-[286px] -translate-x-full flex-col border-r border-line bg-rail py-[18px] shadow-[12px_0_32px_-12px_rgba(20,23,28,0.4)] transition-transform duration-200"
         data-drawer-target="panel"
         data-action="click->drawer#closeOnNavigation">
    <button type="button"
            class="absolute top-[18px] right-4 flex size-8 items-center justify-center rounded-control text-muted hover:bg-line/60"
            data-action="drawer#close"
            aria-label="Close menu">
      <%= icon "x", size: 17, stroke: 2.2 %>
    </button>

    <%= render "layouts/rail_contents" %>
  </aside>
</div>
