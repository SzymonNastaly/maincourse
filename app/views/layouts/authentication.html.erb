<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · MainCourse" : "MainCourse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#EEF0F2">
    <meta name="application-name" content="MainCourse">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "layouts/favicons" %>

    <%# Named explicitly: Propshaft's :app would also pull in the Avo admin CSS. %>
    <%= stylesheet_link_tag "application", "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas font-sans text-ink antialiased">
    <div class="flex min-h-dvh w-full flex-col items-center justify-center p-4">
      <div class="w-full max-w-[420px]">
        <% flash.each do |kind, message| %>
          <% next if message.blank? %>
          <% styles = flash_styles(kind) %>
          <div class="mb-3 flex items-start gap-2.5 rounded-card border px-3 py-2.5 text-[12.5px] <%= styles[:container] %>"
               data-testid="flash-<%= kind %>">
            <%= icon styles[:icon], size: 15, stroke: 2, class: "mt-px" %>
            <span><%= message %></span>
          </div>
        <% end %>

        <div class="rounded-panel border border-hairline bg-surface px-6 py-8 shadow-[0_10px_26px_-18px_rgba(20,23,28,0.4)] sm:px-9 sm:py-10">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
