<% page_title "Create an account" %>

<div class="mb-10 flex items-center gap-2.5">
  <%= brand_mark size: 28 %>
  <span class="text-[17px] font-semibold tracking-[-0.3px]">MainCourse</span>
</div>

<h1 class="mb-2 text-[26px] font-semibold tracking-[-0.7px]">Create your kitchen</h1>
<p class="mb-7 text-[13px] font-light text-muted">Save recipes from anywhere and cook from them on any device.</p>

<%= form_with model: @user, url: registration_path, method: :post do |form| %>
  <% if @user.errors.any? %>
    <div class="mb-4 rounded-card border border-danger-line bg-danger-tint px-3 py-2.5 text-[12.5px] text-danger"
         data-testid="form-errors">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3.5">
    <%= form.label :name, "First name", class: "mc-label" %>
    <%= form.text_field :name, autofocus: true, autocomplete: "given-name", class: "mc-field" %>
  </div>

  <div class="mb-3.5">
    <%= form.label :email_address, "Email", class: "mc-label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username",
                         placeholder: "you@example.com", class: "mc-field" %>
  </div>

  <div class="mb-3.5">
    <%= form.label :password, "Password", class: "mc-label" %>
    <%= form.password_field :password, required: true, minlength: 12,
                            autocomplete: "new-password", class: "mc-field" %>
    <p class="mt-1.5 text-[11px] font-light text-muted">At least 12 characters.</p>
  </div>

  <div class="mb-5">
    <%= form.label :password_confirmation, "Confirm password", class: "mc-label" %>
    <%= form.password_field :password_confirmation, required: true,
                            autocomplete: "new-password", class: "mc-field" %>
  </div>

  <%= form.submit "Create account", class: "mc-btn mc-btn-primary w-full py-3 text-[13.5px]" %>
<% end %>

<p class="mt-8 text-center text-[12.5px] font-light text-muted">
  Already have an account?
  <%= link_to "Sign in", new_session_path, class: "font-medium text-accent hover:text-accent-dark" %>
</p>
