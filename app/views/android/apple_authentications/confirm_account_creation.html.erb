<% page_title t("web.confirm_apple_account") %>

<div class="mb-10 flex items-center gap-2.5">
  <%= brand_mark size: 28 %>
  <span class="text-[17px] font-semibold tracking-[-0.3px]">MainCourse</span>
</div>

<% if @setup_issue == :https %>
  <h1 class="mb-3 text-[26px] font-semibold tracking-[-0.7px]"><%= t("web.apple.https_required") %></h1>
  <p class="mb-7 text-[13px] font-light leading-5 text-body">
    <%= t("web.apple.https_hint") %>
  </p>
<% elsif @setup_issue %>
  <h1 class="mb-3 text-[26px] font-semibold tracking-[-0.7px]"><%= t("web.apple.unavailable") %></h1>
  <p class="mb-7 text-[13px] font-light leading-5 text-body">
    <%= t("web.apple.unavailable_hint") %>
  </p>
<% else %>
  <h1 class="mb-3 text-[26px] font-semibold tracking-[-0.7px]"><%= t("web.apple.create_account") %></h1>
  <p class="mb-7 text-[13px] font-light leading-5 text-body">
    <%= t("web.apple.create_account_hint") %>
  </p>

  <div class="space-y-2.5">
    <%= button_to t("web.apple.cancel_creation"), android_apple_cancel_path,
                  method: :post,
                  params: { transaction_id: @transaction_id },
                  class: "mc-btn mc-btn-outline w-full py-3 text-[13.5px]",
                  form: { data: { turbo: false } } %>
    <%= button_to t("web.create_apple_account"), "/auth/apple?#{Rack::Utils.build_query(android_transaction: @transaction_id, allow_account_creation: true)}",
                  method: :post,
                  class: "mc-btn mc-btn-apple w-full py-3 text-[13.5px]",
                  form: { data: { turbo: false } } %>
  </div>
<% end %>
