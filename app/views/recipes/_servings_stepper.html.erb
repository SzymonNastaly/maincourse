<% if recipe.servings.to_i.positive? %>
  <div class="inline-flex items-center gap-2.5 rounded-card border border-hairline bg-surface px-1 py-[3px]"
       data-testid="servings-stepper">
    <button type="button"
            class="flex size-[21px] items-center justify-center rounded-[4px] bg-sunken text-body disabled:opacity-40"
            data-portion-scaler-target="decrement"
            data-action="portion-scaler#decrement"
            aria-label="Fewer servings">
      <%= icon "minus", size: 12, stroke: 2.4 %>
    </button>

    <div class="flex items-baseline gap-1">
      <span class="font-mono text-[12px] text-ink" data-portion-scaler-target="servings"><%= recipe.servings %></span>
      <span class="text-[10.5px] font-light text-muted" data-portion-scaler-target="label">servings</span>
    </div>

    <button type="button"
            class="flex size-[21px] items-center justify-center rounded-[4px] bg-sunken text-body disabled:opacity-40"
            data-portion-scaler-target="increment"
            data-action="portion-scaler#increment"
            aria-label="More servings">
      <%= icon "plus", size: 12, stroke: 2.4 %>
    </button>
  </div>
<% end %>
