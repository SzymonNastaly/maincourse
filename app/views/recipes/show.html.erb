<% page_title @recipe.name %>
<%= turbo_stream_from current_cookbook %>

<% content_for :mobile_header do %>
  <%= render "layouts/back_bar", label: "All Recipes", path: recipes_path,
             right: render("recipes/detail_actions", recipe: @recipe) %>
<% end %>

<div data-controller="portion-scaler"
     data-portion-scaler-base-servings-value="<%= @recipe.servings.to_i %>"
     data-portion-scaler-servings-value="<%= @recipe.servings.to_i %>">

  <%# ---- Desktop toolbar ------------------------------------------------- %>
  <div class="hidden items-center gap-2.5 border-b border-line px-[30px] py-4 md:flex">
    <%= link_to recipes_path, class: "flex items-center gap-[7px] text-[12.5px] text-body hover:text-ink" do %>
      <%= icon "arrow-left", size: 15, stroke: 2 %><span>All Recipes</span>
    <% end %>
    <div class="grow"></div>
    <%= render "recipes/detail_actions", recipe: @recipe %>
  </div>

  <div class="px-4 pb-10 md:px-[30px] md:pt-[22px]">
    <%# ---- Hero ---------------------------------------------------------- %>
    <div class="-mx-4 h-[150px] overflow-hidden md:mx-0 md:mb-[18px] md:h-[168px] md:rounded-panel"
         style="background: <%= recipe_placeholder_gradient(@recipe) %>">
      <% if @recipe.cover_image.attached? %>
        <%= image_tag @recipe.cover_image.variant(:hero), class: "size-full object-cover", alt: "" %>
      <% end %>
    </div>

    <div class="pt-4 md:pt-0">
      <%# ---- Title + tags + source ---------------------------------------- %>
      <div class="mb-3.5 flex items-start justify-between gap-6 md:mb-3.5">
        <div class="min-w-0">
          <h1 class="mb-2 text-[20px] leading-[1.22] font-semibold tracking-[-0.45px] md:text-[25px] md:tracking-[-0.6px]">
            <%= @recipe.name %>
          </h1>

          <div class="flex flex-wrap items-center gap-1.5">
            <% @recipe.tags.each do |tag| %>
              <%= link_to tag.name, recipes_path(tag: tag.slug),
                          class: "rounded-[4px] bg-sunken px-2 py-[3px] text-[10.5px] text-body hover:text-ink md:text-[11px] md:px-[9px]" %>
            <% end %>

            <% if (source_url = safe_source_url(@recipe)) %>
              <%= link_to source_url, target: "_blank", rel: "noopener noreferrer",
                          class: "ml-1 inline-flex items-center gap-1 text-[11px] text-accent hover:text-accent-dark md:text-[11.5px]" do %>
                <%= icon "external-link", size: 11, stroke: 2 %><span><%= source_domain(@recipe) %></span>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if @recipe.ingredients.any? %>
          <button type="button" class="mc-btn mc-btn-primary hidden md:inline-flex"
                  data-controller="dialog-opener"
                  data-dialog-opener-target-value="add-to-list"
                  data-action="dialog-opener#open"
                  data-testid="add-all-to-list">
            <%= icon "shopping-cart", size: 14, stroke: 2.2 %>
            <span>Add all to shopping list</span>
          </button>
        <% end %>
      </div>

      <%# ---- Timing ------------------------------------------------------ %>
      <% if @recipe.prep_time.to_i.positive? || @recipe.cook_time.to_i.positive? %>
        <div class="flex items-center gap-4 border-b border-line pb-3.5 md:gap-[22px] md:pt-3 md:pb-5">
          <% if @recipe.prep_time.to_i.positive? %>
            <%= render "recipes/meta_stat", icon_name: "clock", label: "Prep", value: format_duration(@recipe.prep_time) %>
          <% end %>
          <% if @recipe.cook_time.to_i.positive? %>
            <%= render "recipes/meta_stat", icon_name: "flame", label: "Cook", value: format_duration(@recipe.cook_time) %>
          <% end %>
        </div>
      <% end %>

      <% if @recipe.ingredients.any? %>
        <div class="py-3.5 md:hidden">
          <button type="button" class="mc-btn mc-btn-primary w-full py-3 text-[13px]"
                  data-controller="dialog-opener"
                  data-dialog-opener-target-value="add-to-list"
                  data-action="dialog-opener#open">
            <%= icon "shopping-cart", size: 15, stroke: 2.2 %>
            <span>Add all to shopping list</span>
          </button>
        </div>
      <% end %>

      <%# ---- Ingredients + method ---------------------------------------- %>
      <div class="md:flex md:gap-[34px] md:pt-5">
        <div class="md:w-[248px] md:shrink-0">
          <% if @ingredients.any? %>
            <div class="mb-3 flex items-center gap-2">
              <span class="mc-section-label">Ingredients</span>
              <div class="grow"></div>
              <%= render "recipes/servings_stepper", recipe: @recipe %>
            </div>

            <% @ingredients.each do |ingredient| %>
              <%= render "recipes/ingredient_row", ingredient: ingredient %>
            <% end %>
          <% end %>
        </div>

        <div class="min-w-0 grow">
          <% if @recipe.instructions.present? %>
            <div class="mt-6 mb-3 md:mt-0">
              <span class="mc-section-label">Method</span>
            </div>

            <% @recipe.instructions.each_with_index do |step, index| %>
              <div class="mb-3.5 flex gap-3 md:mb-4">
                <span class="flex size-[22px] shrink-0 items-center justify-center rounded-control bg-accent-tint font-mono text-[11px] font-medium text-accent">
                  <%= index + 1 %>
                </span>
                <p class="text-[12.5px] leading-[1.62] font-light text-body md:text-[13px]"><%= step %></p>
              </div>
            <% end %>
          <% end %>

          <% if @recipe.notes.present? %>
            <div class="mt-6 mb-3">
              <span class="mc-section-label">Notes</span>
            </div>
            <p class="text-[12.5px] leading-[1.62] font-light text-body italic md:text-[13px]"><%= simple_format @recipe.notes %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @recipe.ingredients.any? %>
    <%= render "recipes/add_to_list_dialog", recipe: @recipe, ingredients: @ingredients %>
  <% end %>
</div>
