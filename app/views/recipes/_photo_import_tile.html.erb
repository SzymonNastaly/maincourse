<%= form_with url: import_photo_recipes_path, method: :post, multipart: true,
              class: "flex-1", data: { controller: "auto-submit" } do |form| %>
  <label class="flex h-full cursor-pointer flex-col gap-2 rounded-[7px] border border-hairline p-[13px] hover:border-accent-line">
    <span class="flex size-8 items-center justify-center rounded-[7px] bg-sunken">
      <%= icon icon_name, size: 16, class: "text-body" %>
    </span>
    <span>
      <span class="mb-0.5 block text-[13px] font-medium"><%= title %></span>
      <span class="block text-[11px] leading-[1.4] font-light text-muted"><%= subtitle %></span>
    </span>
    <%= form.file_field :image,
                        accept: "image/*",
                        capture: capture,
                        class: "sr-only",
                        data: { action: "auto-submit#submit", testid: testid } %>
  </label>
<% end %>
