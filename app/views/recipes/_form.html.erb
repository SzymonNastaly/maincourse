<%= form_with model: recipe, class: "max-w-[640px]", data: { controller: "recipe-form" } do |form| %>
  <% if recipe.errors.any? %>
    <div class="mb-5 rounded-card border border-danger-line bg-danger-tint px-3 py-2.5 text-[12.5px] text-danger"
         data-testid="form-errors">
      <%= recipe.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="mb-3.5">
    <%= form.label :name, class: "mc-label" %>
    <%= form.text_field :name, class: "mc-field", autofocus: recipe.new_record?, data: { testid: "recipe-name" } %>
  </div>

  <%# ---- Cover image ---------------------------------------------------- %>
  <div class="mb-5">
    <span class="mc-label">Cover photo</span>
    <div class="flex items-center gap-3.5">
      <div class="h-[72px] w-[104px] shrink-0 overflow-hidden rounded-card"
           style="background: <%= recipe_placeholder_gradient(recipe) %>">
        <%= image_tag recipe.cover_image.variant(:thumb),
                      class: "size-full object-cover",
                      alt: "",
                      data: { recipe_form_target: "imagePreview" } if recipe.cover_image.attached? %>
        <% unless recipe.cover_image.attached? %>
          <img class="hidden size-full object-cover" alt="" data-recipe-form-target="imagePreview">
        <% end %>
      </div>

      <label class="mc-btn mc-btn-outline cursor-pointer">
        <%= icon "image", size: 14, stroke: 2 %>
        <span><%= recipe.cover_image.attached? ? "Replace photo" : "Choose photo" %></span>
        <%= form.file_field :cover_image, accept: "image/*", class: "sr-only",
                            data: { action: "recipe-form#previewImage" } %>
      </label>
    </div>
  </div>

  <%# ---- Timings --------------------------------------------------------- %>
  <div class="mb-5 grid grid-cols-3 gap-3">
    <div>
      <%= form.label :prep_time, "Prep (min)", class: "mc-label" %>
      <%= form.number_field :prep_time, min: 0, class: "mc-field font-mono" %>
    </div>
    <div>
      <%= form.label :cook_time, "Cook (min)", class: "mc-label" %>
      <%= form.number_field :cook_time, min: 0, class: "mc-field font-mono" %>
    </div>
    <div>
      <%= form.label :servings, class: "mc-label" %>
      <%= form.number_field :servings, min: 1, max: 64, class: "mc-field font-mono" %>
    </div>
  </div>

  <%# ---- Ingredients ------------------------------------------------------ %>
  <div class="mb-5">
    <div class="mb-2.5 flex items-center gap-2">
      <span class="mc-section-label">Ingredients</span>
      <div class="grow"></div>
      <span class="text-[11px] font-light text-muted">One per line, e.g. “200 g plain flour”</span>
    </div>

    <div data-recipe-form-target="ingredientList">
      <% ingredient_values = recipe.ingredients.any? ? recipe.ingredients.map(&:raw) : [ "" ] %>
      <% ingredient_values.each do |value| %>
        <%= render "recipes/form_row", field_name: "recipe[ingredients][]", value: value,
                   placeholder: "200 g plain flour", multiline: false %>
      <% end %>
    </div>

    <button type="button" class="mc-btn mc-btn-outline mt-2 px-3 py-1.5 text-[12px]"
            data-action="recipe-form#addIngredient" data-testid="add-ingredient">
      <%= icon "plus", size: 13, stroke: 2.2 %><span>Add ingredient</span>
    </button>
  </div>

  <%# ---- Method ---------------------------------------------------------- %>
  <div class="mb-5">
    <div class="mb-2.5">
      <span class="mc-section-label">Method</span>
    </div>

    <div data-recipe-form-target="instructionList">
      <% instruction_values = recipe.instructions.presence || [ "" ] %>
      <% instruction_values.each do |value| %>
        <%= render "recipes/form_row", field_name: "recipe[instructions][]", value: value,
                   placeholder: "Describe the step", multiline: true %>
      <% end %>
    </div>

    <button type="button" class="mc-btn mc-btn-outline mt-2 px-3 py-1.5 text-[12px]"
            data-action="recipe-form#addInstruction" data-testid="add-instruction">
      <%= icon "plus", size: 13, stroke: 2.2 %><span>Add step</span>
    </button>
  </div>

  <%# ---- Collections ------------------------------------------------------ %>
  <% if (tags = Tag.order(:name)).any? %>
    <div class="mb-5">
      <div class="mb-2.5"><span class="mc-section-label">Collections</span></div>
      <div class="flex flex-wrap gap-1.5">
        <%= hidden_field_tag "recipe[tag_ids][]", "", id: nil %>
        <% tags.each do |tag| %>
          <% checked = recipe.tag_ids.include?(tag.id) %>
          <label class="cursor-pointer rounded-control border px-3 py-[5px] text-[12px] transition-colors has-checked:border-ink has-checked:bg-ink has-checked:font-medium has-checked:text-white <%= checked ? "" : "border-hairline text-body" %>">
            <%= check_box_tag "recipe[tag_ids][]", tag.id, checked, id: nil, class: "sr-only" %>
            <%= tag.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ---- Notes + source --------------------------------------------------- %>
  <div class="mb-3.5">
    <%= form.label :notes, class: "mc-label" %>
    <%= form.text_area :notes, rows: 3, class: "mc-field" %>
  </div>

  <div class="mb-6">
    <%= form.label :source_url, "Source link", class: "mc-label" %>
    <%= form.url_field :source_url, placeholder: "https://…", class: "mc-field font-mono text-[12px]" %>
  </div>

  <div class="flex items-center gap-2.5">
    <%= form.submit(recipe.new_record? ? "Save recipe" : "Save changes",
                    class: "mc-btn mc-btn-primary", data: { testid: "save-recipe" }) %>
    <%= link_to "Cancel", recipe.new_record? ? recipes_path : recipe_path(recipe),
                class: "mc-btn mc-btn-quiet" %>
  </div>

  <%# Templates for the dynamically added rows. %>
  <template data-recipe-form-target="ingredientTemplate">
    <%= render "recipes/form_row", field_name: "recipe[ingredients][]", value: "",
               placeholder: "200 g plain flour", multiline: false %>
  </template>

  <template data-recipe-form-target="instructionTemplate">
    <%= render "recipes/form_row", field_name: "recipe[instructions][]", value: "",
               placeholder: "Describe the step", multiline: true %>
  </template>
<% end %>
