<% page_title @active_tag ? @active_tag.name : "Recipes" %>
<%= turbo_stream_from current_cookbook %>

<%# ---- Desktop header ---------------------------------------------------- %>
<div class="hidden items-start justify-between gap-5 px-[30px] pt-[26px] md:flex">
  <div>
    <h1 class="mb-1.5 text-[29px] font-semibold tracking-[-0.7px]"><%= @active_tag ? @active_tag.name : "All Recipes" %></h1>
    <div class="text-[12.5px] font-light text-muted">
      <%= mono @recipes.size, class: "text-[12px]" %>
      <%= "recipe".pluralize(@recipes.size) %> in <%= current_cookbook.name %>
    </div>
  </div>

  <div class="flex items-center gap-2.5 pt-1.5">
    <%= render "recipes/search_field" %>
    <%= render "recipes/add_button" %>
  </div>
</div>

<%# ---- Mobile header ----------------------------------------------------- %>
<div class="flex items-start justify-between gap-4 px-4 pt-[18px] md:hidden">
  <div class="min-w-0">
    <h1 class="mb-1 truncate text-[23px] font-semibold tracking-[-0.5px]"><%= @active_tag ? @active_tag.name : "All Recipes" %></h1>
    <button type="button" class="flex items-center gap-1.5 text-muted"
            data-controller="dialog-opener"
            data-dialog-opener-target-value="cookbook-switcher"
            data-action="dialog-opener#open">
      <span class="text-[11.5px] font-light"><%= current_cookbook.name %> ·</span>
      <%= mono @recipes.size, class: "text-[11px]" %>
      <%= icon "chevron-down", size: 11, stroke: 2.4 %>
    </button>
  </div>

  <button type="button"
          class="flex size-10 shrink-0 items-center justify-center rounded-panel bg-accent text-white"
          data-controller="dialog-opener"
          data-dialog-opener-target-value="add-recipe"
          data-action="dialog-opener#open"
          aria-label="Add a recipe">
    <%= icon "plus", size: 19, stroke: 2.4 %>
  </button>
</div>

<div class="px-4 pt-4 md:hidden">
  <%= render "recipes/search_field", mobile: true %>
</div>

<%# ---- Failed imports ---------------------------------------------------- %>
<% if @failed_imports.any? %>
  <div class="flex flex-col gap-2.5 px-4 pt-4 md:px-[30px]">
    <% @failed_imports.each do |failed| %>
      <%= render "recipes/failed_import", recipe: failed %>
    <% end %>
  </div>
<% end %>

<%# ---- Collections + sort ------------------------------------------------ %>
<div class="px-4 py-3.5 md:border-b md:border-line md:px-[30px] md:pt-5 md:pb-4">
  <%= render "recipes/filters" %>
</div>

<%# ---- Grid -------------------------------------------------------------- %>
<div class="px-4 pb-8 md:px-[30px] md:pt-6">
  <% if @recipes.any? %>
    <div class="grid grid-cols-2 gap-x-3.5 gap-y-[18px] md:grid-cols-3 md:gap-x-5 md:gap-y-6">
      <%= render partial: "recipes/card", collection: @recipes, as: :recipe %>
    </div>
  <% elsif @active_tag %>
    <%= render "shared/empty_state",
               icon: "utensils",
               title: "Nothing in #{@active_tag.name} yet",
               body: "Tag a recipe with #{@active_tag.name} and it will show up here.",
               action: link_to("All recipes", recipes_path, class: "mc-btn mc-btn-outline") %>
  <% else %>
    <%= render "shared/empty_state",
               icon: "utensils",
               title: "No recipes yet",
               body: "Paste a link, upload a photo of a cookbook page, or write one out yourself.",
               action: render("recipes/add_button") %>
  <% end %>
</div>

<%= render "recipes/add_dialog" %>
