<div class="flex flex-col items-center justify-center gap-3 px-10 py-16 text-center" data-testid="empty-state">
  <div class="flex size-[52px] items-center justify-center rounded-[12px] bg-sunken">
    <%= icon local_assigns.fetch(:icon, "utensils"), size: 24, stroke: 1.7, class: "text-muted" %>
  </div>
  <div>
    <div class="mb-1.5 text-[15px] font-medium"><%= title %></div>
    <% if local_assigns[:body].present? %>
      <div class="max-w-xs text-[12.5px] leading-relaxed font-light text-muted"><%= body %></div>
    <% end %>
  </div>
  <% if local_assigns[:action].present? %>
    <div class="pt-1"><%= action %></div>
  <% end %>
</div>
